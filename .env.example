PORT=3001
NODE_ENV=development

# https://azec-services-staging.erajaya.com for development, https://paymentservices-evs.erajaya.com:9448 for production
PPS_BASE_URL=https://azec-services-staging.erajaya.com
PPS_USER=your_registered_username
PPS_PASSWORD=your_pps_password

# CheckCustomer punya host & port sendiri, beda dari endpoint lain (liat PPS_INTEGRATION_NOTES.md)
PPS_CHECK_CUSTOMER_BASE_URL=https://paymentservices-evs.erajaya.com:9447

# URL IRS yang di-hit middleware saat callback PPS masuk (kosongin buat nonaktifin forwarding)
IRS_CALLBACK_URL=http://..
